# VERSIÓN INGENUA (una sola etapa) — solo para comparar tamaños.
# Funciona, pero la imagen final lleva el SDK completo (compilador, NuGet, código fuente...).
FROM mcr.microsoft.com/dotnet/sdk:10.0
WORKDIR /src
COPY . .
RUN dotnet publish -c Release -o /app
WORKDIR /app
EXPOSE 8080
ENTRYPOINT ["dotnet", "ConvocatoriasApi.dll"]
